{
  "manifest_version": 3,
  "name": "MargFlow Recorder",
  "version": "0.1.0",
  "description": "Record user workflows as step-by-step guides",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/recorder.js"],
      "run_at": "document_idle"
    }
  ]
}